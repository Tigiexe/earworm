# Earworm server settings. Copy to .env and fill in.

# The public address of the site, no trailing slash. Used for the Spotify redirect,
# the multiplayer origin check and HTTPS headers.
PUBLIC_URL=https://earworm.example.com

# Client ID of your Spotify app (developer.spotify.com/dashboard). 32 characters.
# Leave empty to let visitors paste their own (handy for testing only).
SPOTIFY_CLIENT_ID=

# Where the Node server listens. Keep 127.0.0.1 — Caddy/nginx/Cloudflare Tunnel sit in front of it.
HOST=127.0.0.1
PORT=8000

# Read the visitor's IP from X-Forwarded-For (the reverse proxy sets it). On by default when PUBLIC_URL is set.
# Only turn this on when the port above is NOT reachable directly from the internet.
#TRUST_PROXY=1

# Chart shown to first-time visitors: Worldwide, USA, UK, Germany, Croatia, …
DEFAULT_CHART=Worldwide

# Multiplayer limits
#MAX_ROOMS=200
#MAX_PLAYERS=16

# Let visitors paste a Client ID in the browser when SPOTIFY_CLIENT_ID is empty (default: on when it is empty)
#ALLOW_CLIENT_ID_SETUP=0
